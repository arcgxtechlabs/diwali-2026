    "remotion:studio": "remotion studio video/index.ts",
    "remotion:render": "remotion render video/index.ts",
    "remotion:render:all": "node scripts/render-cinematics.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@remotion/player": "4.0.541",
    "@remotion/three": "^4.0.541",
    "postprocessing": "^6.39.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.541",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.541",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.0",
