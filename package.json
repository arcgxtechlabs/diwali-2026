{
  "name": "arcgx-diwali-2026",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "The Night Before the Lights: ArcGX TechLabs Diwali 2026 cinematic story game. Krishna, Satyabhama and Narakasura in real-time 3D with Remotion-driven VFX cinematics.",
  "author": "Suneel Bose <suneelbose@arcgx.in>",
  "scripts": {
    "dev": "vite",
